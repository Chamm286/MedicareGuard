    {
      "name": "Compute Business Impact",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const read = (name) => { try { return $(name).first().json || {}; } catch (error) { return {}; } };\nconst base = read('Correlate Threat Indicators');\nconst record = read('Load Control Inventory');\nconst asset = read('Load Asset Ownership');\nconst related = read('Load Related Activity');\nconst severity = String(record.severity || record.status || '').toLowerCase();\nconst severityWeight = { critical: 45, high: 30, medium: 15, low: 5 }[severity] || 10;\nconst criticalityWeight = { critical: 25, high: 18, medium: 10, low: 4 }[String(asset.criticality || '').toLowerCase()] || 5;\nconst exposure = Number(record.cvss_score ? Number(record.cvss_score) * 6 : record.score ? (100 - Number(record.score)) * 0.55 : 25);\nconst relatedWeight = Math.min(20, Object.values(related).reduce((sum, value) => sum + Number(value || 0), 0) * 2);\nlet riskScore = Math.round(severityWeight + criticalityWeight + exposure + relatedWeight);\nif (record.score !== undefined && record.cvss_score === undefined) riskScore = Math.max(15, Math.min(100, 100 - Number(record.score)));\nriskScore = Math.max(1, Math.min(100, riskScore || 50));\nreturn [{ json: { ...base, record, asset, related, riskScore, severity: severity || 'medium', workflowName: 'Continuous Compliance Evidence', entityId: base.entityId, entityType: 'compliance_control', correlationId: base.correlationId } }];"
      },
      "position": [
        640,
        360
      ],
      "id": "67a12c54-1978-5da1-b77d-4b27d5c2e262"
    },
