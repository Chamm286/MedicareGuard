      "typeVersion": 2,
      "parameters": {
        "jsCode": "const base = $('Merge Enrichment Context').first().json;\nconst record = $('Load Alert Record').first().json || {};\nconst asset = $('Load Asset Ownership').first().json || {};\nconst related = $('Count Related Incidents').first().json || {};\nconst severityWeight = { critical: 45, high: 30, medium: 15, low: 5 }[String(record.severity || record.status || '').toLowerCase()] || 10;\nconst criticalityWeight = { critical: 25, high: 18, medium: 10, low: 4 }[String(asset.criticality || '').toLowerCase()] || 5;\nconst exposure = Number(record.cvss_score ? record.cvss_score * 3 : (record.risk_score || 50) * 0.3);\nconst relatedWeight = Math.min(20, Object.values(related).reduce((sum, value) => sum + Number(value || 0), 0) * 2);\nconst riskScore = Math.max(1, Math.min(100, Math.round(severityWeight + criticalityWeight + exposure + relatedWeight)));\nreturn [{ json: { ...base, asset, related, record, riskScore, workflowName: 'Phishing Triage & Credential Reset', entityId: base.entityId, entityType: 'alert', correlationId: base.correlationId } }];"
