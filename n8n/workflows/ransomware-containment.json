    {
      "name": "Score Risk & Build Alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const read = (name) => { try { return $(name).first().json || {}; } catch (error) { return {}; } };\nconst base = read('Validate Webhook Payload');\nconst record = read('Load Alert Record');\nconst asset = read('Load Asset Ownership');\nconst primary = read('Enrich — EDR Telemetry');\nconst reputation = read('Enrich — Threat Reputation');\nconst severity = String(record.severity || record.status || 'medium').toLowerCase();\nconst severityWeight = { critical: 55, high: 38, medium: 20, low: 8 }[severity] || 15;\nconst criticalityWeight = { critical: 22, high: 15, medium: 8, low: 3 }[String(asset.criticality || '').toLowerCase()] || 5;\nconst cvss = Number(record.cvss_score || 0);\nconst vulnWeight = cvss ? Math.round(cvss * 3) : 0;\nlet riskScore = severityWeight + criticalityWeight + vulnWeight;\nif (record.score !== undefined && record.cvss_score === undefined) riskScore = 100 - Number(record.score);\nriskScore = Math.max(1, Math.min(100, riskScore || 50));\nreturn [{ json: { ...base, record, asset, primary, reputation, riskScore, severity: severity || 'medium', workflowName: 'Ransomware Containment & Recovery', entityId: base.entityId, entityType: 'alert', correlationId: base.executionId.slice(0, 8) } }];"
      },
      "position": [
        300,
        480
      ],
      "id": "3781867b-9ba7-530c-ba92-305f00776b3e"
    },
    {
