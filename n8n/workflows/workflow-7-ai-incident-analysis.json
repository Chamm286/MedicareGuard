    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, title, severity, category, detected_at FROM incidents\nWHERE category = $1 AND detected_at > now() - interval '30 days'\nORDER BY detected_at DESC LIMIT 10;",
        "options": {
          "queryReplacement": "={{ [$('03 Normalize').item.json.category] }}"
        }
      },
      "id": "f0aa2679-0c54-42b4-a06e-6a13fa118caa",
      "name": "07 Load Context",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
