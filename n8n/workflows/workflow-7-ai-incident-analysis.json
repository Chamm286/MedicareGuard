      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, incident_key, status FROM incidents WHERE incident_key = $1 LIMIT 1;",
        "options": {
          "queryReplacement": "={{ [$json.incident_key] }}"
        }
      },
