    {
      "parameters": {
        "jsCode": "const inc = $('03 Normalize').item.json;\nconst history = $items('07 Load Context').map(i => i.json);\nconst ctx = `INCIDENT:\\n- key: ${inc.incident_key}\\n- title: ${inc.title}\\n- description: ${inc.description}\\n- severity: ${inc.severity}\\n- category: ${inc.category}\\n- detected_at: ${inc.detected_at}\\n\\nRECENT SIMILAR INCIDENTS (last 30d):\\n${history.map(h => `- ${h.title} [${h.severity}] ${h.detected_at}`).join('\\n') || 'none'}`;\nreturn [{ json: { ai_context: ctx, incident_id: $('06 Create Incident').item.json.id, incident_key: inc.incident_key } }];"
      },
      "id": "bacce781-5f05-4a48-a0e2-26b7dee32993",
      "name": "08 Build AI Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1328,
        112
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.ai_context }}",
        "options": {
          "systemMessage": "You are a SOC incident analyst for MedicareGuard (healthcare). Analyze the incident.\nReturn ONLY valid JSON with fields:\n- category: one of compliance|phishing|ransomware|vulnerability|ai-incident\n- severity: critical|high|medium|low\n- root_cause: string\n- impact: string\n- remediation_steps: array of strings\n- prevention: string\nDo NOT include markdown or extra text.",
          "returnIntermediateSteps": false,
          "passthroughBinaryPdfs": false,
          "tracingMetadata": {
            "values": [
              {}
            ]
          }
        }
      },
      "id": "d29df738-2a82-41d3-b267-89ab25a91f18",
      "name": "09 AI Agent Analyst",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        -1104,
        112
      ]
    },
    {
      "parameters": {
        "jsCode": "// Lấy dữ liệu từ AI hoặc từ phần normalize/input ban đầu\nconst ai = $json.output || $json;\n\n// Ưu tiên lấy severity từ AI, nếu không có thì lấy từ Normalize (Node 03) hoặc mặc định là medium\nconst rawSeverity = ai.severity || $('03 Normalize').first().json.severity || 'medium';\nconst sev = String(rawSeverity).toLowerCase();\n\nconst priority = sev === 'critical' ? 'P1' : sev === 'high' ? 'P2' : 'P3';\n\nreturn [{ \n  json: { \n    ...ai, \n    severity: sev, \n    priority, \n    incident_id: $('08 Build AI Context').first().json.incident_id \n  } \n}];"
      },
      "id": "a5aaf947-e078-45f0-8bdc-dee39d77a97d",
      "name": "12 Calculate Priority",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -656,
        112
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE incidents SET\n  severity=$1, priority=$2, category=$3, root_cause=$4, impact=$5,\n  status='investigating',\n  metadata = COALESCE(metadata,'{}'::jsonb) || jsonb_build_object(\n    'ai_analysis', $6::jsonb,\n    'ai_analyzed_at', now()\n  )\nWHERE id=$7 RETURNING id;",
        "options": {
          "queryReplacement": "={{ [ $json.severity, $json.priority, $json.category, $json.root_cause, $json.impact, JSON.stringify({steps:$json.remediation_steps, prevention:$json.prevention}), $json.incident_id ] }}"
        }
      },
