    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO incidents (incident_key, title, description, severity, status, priority, category, detected_at, sla_due_at, metadata)\nVALUES ($1,$2,$3,$4,'open','P3',$5,$6,$7,'{}'::jsonb)\nRETURNING id, incident_key;",
        "options": {
          "queryReplacement": "={{ [ $('03 Normalize').item.json.incident_key, $('03 Normalize').item.json.title, $('03 Normalize').item.json.description, $('03 Normalize').item.json.severity, $('03 Normalize').item.json.category, $('03 Normalize').item.json.detected_at, new Date(Date.now()+4*3600*1000).toISOString() ] }}"
        }
      },
      "id": "870c2148-d97f-4382-b884-6fc30fc281e5",
      "name": "06 Create Incident",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
