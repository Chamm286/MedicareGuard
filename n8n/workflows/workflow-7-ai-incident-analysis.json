    {
      "parameters": {
        "jsCode": "const b = $json.body;\nconst now = new Date().toISOString();\nreturn [{\n  json: {\n    incident_key: String(b.incident_key).slice(0,32),\n    title: b.title,\n    description: b.description || '',\n    severity: (b.severity || 'medium').toLowerCase(),\n    category: b.category || 'ai-incident',\n    detected_at: b.detected_at || now,\n    source_ip: b.source_ip || null,\n    raw: b\n  }\n}];"
      },
      "id": "fa45b22e-2e3a-46ce-8048-49fb769f751e",
      "name": "03 Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
