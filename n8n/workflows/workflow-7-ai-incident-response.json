    {
      "parameters": {
        "jsCode": "\nconst b = $json.body ?? $json;\nfor (const k of ['event_id','user_id','ip_address']) {\n  if (!b[k]) throw new Error('Missing required field: ' + k);\n}\nreturn [{json:{...b, event_id:String(b.event_id),\n user_id:String(b.user_id), ip_address:String(b.ip_address),\n timestamp:b.timestamp || new Date().toISOString(),\n execution_id:$execution.id}}];\n"
      },
      "id": "f423c424-4c8d-424a-9c41-e257d2706679",
      "name": "02 Validate Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        112
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT *\nFROM activity_logs\nWHERE actor_id = $1::uuid\n  AND created_at >= NOW() - INTERVAL '7 days'\nORDER BY created_at DESC\nLIMIT 200;",
        "options": {
          "queryReplacement": "={{ [$('02 Validate Payload').first().json.user_id] }}"
        }
      },
      "id": "2c6d1431-8e5e-4c6c-8e08-682d6e6e43c1",
      "name": "03 User History 7 Days",
      "type": "n8n-nodes-base.postgres",
