      "name": "07 Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.2,
      "position": [
        1088,
        352
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "UnD2Sjsg9CRhyays",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "\nlet v = $json.output ?? $json.text ?? $json;\nif (typeof v === 'string') {\n v = JSON.parse(v.replace(/^```json\\\\s*/i,'').replace(/```$/,'').trim());\n}\nconst score = Number(v.risk_score);\nif (!Number.isFinite(score) || score < 0 || score > 100)\n throw new Error('AI risk_score must be 0..100');\nreturn [{json:{...$('02 Validate Payload').first().json,\n verdict:v, risk_score:score,\n priority:score>=75?'P1':score>=50?'P2':'P3'}}];\n"
      },
      "id": "1a74729f-d1fa-4249-854e-98b39a358e48",
      "name": "08 Parse AI Verdict",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1376,
        112
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.risk_score }}",
              "rightValue": 75,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "08d18d0c-11d4-4204-a741-16868177779e",
      "name": "09 Risk >= 75",
