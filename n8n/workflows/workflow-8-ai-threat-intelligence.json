      "id": "c47971b3-9c52-4d2f-9802-dca96b055f49",
      "name": "01 Daily 06:00 Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        16,
        32
      ]
    },
    {
      "parameters": {
        "url": "={{ ($env.MG_API_URL || 'http://backend:4000') + '/api/n8n/system/tech-stack' }}",
        "sendHeaders": true,
        "headerParameters": {
