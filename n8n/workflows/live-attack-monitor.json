    {
      "name": "Schedule — Every 5 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "position": [
        0,
        160
      ],
      "id": "6549e602-81b9-5bf5-a8d7-1d599bb95789"
    },
    {
      "name": "Normalize Monitor Trigger",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst executionId = String(body.executionId || ('monitor-' + Date.now()));\nreturn [{ json: { ...body, executionId, workflowId: 'live-attack-monitor', workflowName: 'Live Attack Monitor & Phone Alerts', mode: body.mode || 'scheduled', startedAt: body.startedAt || new Date().toISOString() } }];"
      },
      "position": [
        0,
        320
      ],
      "id": "0bab4752-3cdf-5ee0-9e7d-d9fdb81d343b"
    },
    {
      "name": "Load Recent Attacks",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COALESCE(json_agg(row_to_json(t)), '[]'::json) AS attacks, count(*)::int AS count\nFROM (\n  SELECT id, title, severity, source_ip, risk_score, detected_at\n  FROM alerts\n  WHERE severity IN ('critical','high')\n    AND detected_at > now() - interval '24 hours'\n    AND COALESCE(metadata->>'phoneNotifiedAt','') = ''\n  ORDER BY detected_at DESC LIMIT 5\n) t;",
        "options": {}
      },
      "position": [
        300,
        0
      ],
      "id": "df485150-dd72-5b71-b8cd-36e8ca879f72",
      "credentials": {
        "postgres": {
          "id": "mg-postgres-credential",
          "name": "MedicareGuard PostgreSQL"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "name": "Build Phone Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const attacks = Array.isArray($json.attacks) ? $json.attacks : [];\nconst lines = attacks.map(function (a) { return '• [' + a.severity + '] ' + a.title + ' — ' + (a.source_ip || 'unknown') + ' (' + (a.risk_score || 0) + '/100)'; });\nconst text = '🚨 MedicareGuard live attack monitor\\n' + attacks.length + ' new high-risk attack(s) detected in the last 24h.\\n\\n' + lines.join('\\n') + '\\n\\nConsole: http://localhost:3000/alerts';\nconst base = $('Normalize Monitor Trigger').first().json;\nreturn [{ json: { ...base, count: attacks.length, attacks, summary: lines.join(' | '), text } }];"
      },
      "position": [
        300,
        160
      ],
      "id": "fb3262c1-f6cb-513a-b5a3-96b1f395d83e"
    },
    {
      "name": "New Attacks?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "1d86e6be-62a1-5f5f-8b98-d174a635f897",
              "leftValue": "={{ $json.count }}",
              "rightValue": 1,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "position": [
        300,
        320
      ],
      "id": "3781867b-9ba7-530c-ba92-305f00776b3e"
    },
    {
      "name": "Load Alert Recipients",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT u.id, u.email, u.full_name FROM users u JOIN roles r ON r.id = u.role_id WHERE r.name IN ('admin','analyst') ORDER BY r.level DESC LIMIT 1;",
        "options": {}
      },
      "position": [
        600,
        0
      ],
      "id": "4b7f7ff8-02f7-5bc2-9518-59cf2e88a7c9",
      "credentials": {
        "postgres": {
          "id": "mg-postgres-credential",
          "name": "MedicareGuard PostgreSQL"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "name": "Telegram Ready?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
