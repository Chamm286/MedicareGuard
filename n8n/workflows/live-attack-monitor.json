      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE alerts SET metadata = metadata || jsonb_build_object('phoneNotifiedAt', now()::text), updated_at = now()\nWHERE severity IN ('critical','high')\n  AND detected_at > now() - interval '24 hours'\n  AND COALESCE(metadata->>'phoneNotifiedAt','') = ''\nRETURNING id;",
        "options": {}
      },
      "position": [
