{
  "id": "live-attack-monitor",
  "name": "Live Attack Monitor & Phone Alerts",
  "active": false,
  "nodes": [
    {
      "name": "Webhook — Monitor Tick",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "parameters": {
        "httpMethod": "POST",
        "path": "mg-attack-monitor",
