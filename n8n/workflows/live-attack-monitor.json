      "typeVersion": 2,
      "parameters": {
        "jsCode": "const base = $('Normalize Monitor Trigger').first().json;\nconst built = $('Build Phone Message').first().json;\nconst count = Number(built.count || 0);\nreturn [{ json: { workflowId: 'live-attack-monitor', status: 'success', durationMs: Math.max(1, Date.now() - new Date(base.startedAt).getTime()), nodeCount: 18, metrics: { attack_count: count, channels: ['telegram','gmail'], lookback_hours: 24 }, message: 'n8n live attack monitor found ' + count + ' new attack(s)' } }];"
