# ─────────────────────────────────────────────────────────────
# MedicareGuard SOC — Environment configuration
# Copy to `.env` and adjust values for your environment.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
TZ=Asia/Ho_Chi_Minh

# PostgreSQL
POSTGRES_USER=medicare
POSTGRES_PASSWORD=medicare
POSTGRES_DB=medicareguard
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://medicare:medicare@postgres:5432/medicareguard
DATABASE_SSL=false

# Backend
PORT=4000
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
JWT_SECRET=change-me-in-production-medicareguard-2026
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=10
SEED_ON_START=false

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_APP_NAME=MedicareGuard SOC
NEXT_PUBLIC_MAILPIT_URL=http://localhost:8025
NEXT_PUBLIC_REFRESH_INTERVAL=30000

# n8n
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=medicareguard
N8N_ENCRYPTION_KEY=change-me-n8n-encryption-key-2026
GENERIC_TIMEZONE=Asia/Ho_Chi_Minh

# AI service (optional external provider — deterministic analyst works offline)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# n8n callback configuration (mint with: cd backend && npm run token:n8n)
MG_API_URL=http://localhost:4000/api
MG_API_TOKEN=
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# SOC phone alerts (Telegram + Gmail)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MG_CONSOLE_URL=http://localhost:3000
MG_ALERT_EMAIL=soc@medicareguard.io
MG_SMTP_HOST=host.docker.internal
MG_SMTP_PORT=1025
MG_SMTP_SECURE=false
# Set true for local SMTP sinks (e.g. Mailpit on 127.0.0.1:1025) that do not offer STARTTLS
MG_SMTP_DISABLE_STARTTLS=true
MG_SMTP_USER=mailpit
MG_SMTP_PASSWORD=mailpit
MG_SMTP_FROM=alerts@medicareguard.io

# SePay automatic payment (optional; fill with your SePay merchant account)
SEPAY_ACCOUNT_NUMBER=
SEPAY_BANK_CODE=
SEPAY_ACCOUNT_NAME=Medicare Store
SEPAY_WEBHOOK_SECRET=
N8N_BASE_URL=http://localhost:5678
N8N_AI_CHAT_URL=http://localhost:5678/webhook/mg-ai-chat
N8N_AI_CHAT_TIMEOUT_MS=15000
DEMO_MODE=true
